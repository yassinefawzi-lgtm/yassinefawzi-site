# URL canonique. Confirmer le domaine avant de publier.
NEXT_PUBLIC_SITE_URL=https://yassinefawzi.fr
# false = prépublication : noindex et sitemap vide. Activer après revue éditoriale/légale.
NEXT_PUBLIC_INDEXABLE=false
# Formulaire : configurer une clé Resend et une adresse d'expédition vérifiée.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Obligatoire en production : Turnstile, vérification serveur et hôte autorisé.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=yassinefawzi.fr,www.yassinefawzi.fr
# Rester vide jusqu'à configuration des tags et contrôle du consentement dans GTM.
NEXT_PUBLIC_GTM_ID=
# Pour validation de propriété Search Console (optionnel si vérification DNS).
GOOGLE_SITE_VERIFICATION=
